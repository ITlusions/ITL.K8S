# Copy to deploy.env (git-ignored) and fill in the values for your environment.
# Nothing in this file is secret, but keep your real deploy.env out of git anyway.

# --- Cluster ---------------------------------------------------------------
CLUSTER_NAME=itl
# Control-plane VIP (shared by the two control-plane nodes, must be unused)
CLUSTER_VIP=10.99.100.10
CLUSTER_ENDPOINT=https://10.99.100.10:6443

# Talos and Kubernetes versions. Talos v1.14.4 ships Kubernetes v1.37.1.
TALOS_VERSION=v1.14.4
# Installer image from https://factory.talos.dev with the extensions Longhorn needs
# Schematic 8479232c...: iscsi-tools, util-linux-tools, intel-ucode, amd-ucode, amdgpu.
TALOS_INSTALLER_IMAGE="factory.talos.dev/installer/8479232c408ba2e411fefcf18c0e83ac657875c4d4d2b09b55a31a38b9c013a1:v1.14.4"
KUBERNETES_VERSION=1.37.1   # latest release; the default for Talos v1.14.4

# --- Nodes -----------------------------------------------------------------
# name:ip:role   (role = controlplane or worker)
NODES="talos-cp01:10.99.100.11:controlplane talos-cp02:10.99.100.12:controlplane talos-w01:10.99.100.21:worker talos-w02:10.99.100.22:worker talos-w03:10.99.100.23:worker"
# Network interface on each node (check with `talosctl get links` once Talos is running)
NODE_INTERFACE=eth0
# Install disk (must NOT be the Longhorn data disk)
INSTALL_DISK=/dev/sda
NODE_GATEWAY=10.99.100.1

# --- Cilium --------------------------------------------------------------
# Deployed from ITlusions/ITL.Cilium (cloned as a sibling of this repo) -
# its version is pinned in that repo's Chart.yaml, not configured here.

# --- MetalLB with BGP --------------------------------------------------------
# 0.14.9's BGPPeer CRD declares myASN/peerASN as format:int32 with maximum:4294967295,
# which exceeds int32's range - Kubernetes 1.37's structural schema validation rejects
# it outright ("Maximum boundary value must be of type integer with format int32").
# Fixed in 0.16.1 (format:int64). Stay on 0.16.1+ with Kubernetes 1.37+.
METALLB_VERSION=0.16.1
# Pool that the LoadBalancer IPs come from (VLAN 99)
LB_POOL=10.99.99.20-10.99.99.100
# Node-side ASN (private) and router ASN and address
BGP_NODE_ASN=64512
BGP_ROUTER_ASN=64512
BGP_ROUTER_ADDRESS=10.99.100.1
